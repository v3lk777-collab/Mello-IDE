{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mello IDE",
  "version": "0.1.6",
  "identifier": "com.mohammed.mello-ide",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "Mello IDE",
        "width": 1200,
        "height": 600,
        "minWidth": 1000,
        "center": true,
        "minHeight": 600,
        "decorations": false
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Mohammed Tamer El-Azab",
    "copyright": "Copyright © 2026 Mohammed Tamer Mohammed Ahmed El-Azab Nour. All rights reserved.",
    "shortDescription": "Modern IDE for Mello Programming Language",
    "longDescription": "A lightweight, high-performance IDE built for transpiling Mello code into optimized C++ for microcontrollers.",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
  
    "resources": [
      "mello/build/mello.exe",
      "mello/stdlib/",
      "mello/libs/",
      "mello/bin/win32/arduino-cli.exe",
      "mello/bin/win32/clang-format.exe"
    ],

    "fileAssociations": [
      {
        "ext": ["mello"],
        "name": "Mello Source File",
        "description": "Mello Programming Language source file",
        "role": "Editor"
      }
    ]
  },

  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwRkJGMDZDMjg3RUIwNzEKUldSeHNING9iUEQ3b0NJa25OUVQxYUZjNHhQMmxlbDExVmtIeFZKNk1NM0dhT0xxSFFzOTVyQ1EK",
      "endpoints": [
        "https://github.com/v3lk777-collab/Mello-IDE/releases/latest/download/latest.json"
      ]
    }
  }
}